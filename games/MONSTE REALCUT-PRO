<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#1b0f3d">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦅</text></svg>">
<title>TALON STRIKE — Jungle Estate Defense</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Poppins:wght@400;600;700;800&display=swap');
  :root{
    --gold:#ffd27a; --gold2:#ffb23d; --danger:#ff4d4d; --shadow-purple:#a86bff;
  }
  *{margin:0;padding:0;box-sizing:border-box;user-select:none;-webkit-user-select:none;touch-action:none;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow:hidden;background:#0c0620;font-family:'Poppins',sans-serif}
  canvas{display:block;position:absolute;top:0;left:0;width:100%;height:100%}

  #ui{position:absolute;top:0;left:0;width:100%;padding:12px 14px;display:flex;justify-content:space-between;align-items:flex-start;pointer-events:none;z-index:10}
  .stat{background:rgba(20,10,35,0.45);backdrop-filter:blur(14px);border:1px solid rgba(255,210,122,0.22);padding:7px 14px;border-radius:12px;color:#fff;font-size:12px;letter-spacing:1.5px;margin-bottom:6px;font-weight:600}
  .stat b{color:var(--gold);font-family:'Orbitron';font-size:16px;letter-spacing:0;margin-left:4px}
  #leftStats{display:flex;flex-direction:column;align-items:flex-start}
  #rightStats{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
  #lives{display:flex;align-items:center;gap:5px;background:rgba(20,10,35,0.45);backdrop-filter:blur(14px);border:1px solid rgba(255,210,122,0.22);padding:6px 12px;border-radius:12px;filter:drop-shadow(0 0 6px rgba(168,107,255,.5))}
  #livesBar{width:62px;height:6px;border-radius:4px;background:rgba(255,255,255,0.15);overflow:hidden;display:inline-block}
  #livesBarFill{display:block;height:100%;border-radius:4px;transition:width .25s}
  #topRightRow{display:flex;gap:6px;pointer-events:all}
  #pauseBtn{cursor:pointer;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.18);color:#fff;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px}
  #weaponRow{display:flex;gap:6px;pointer-events:all}
  .wbtn{cursor:pointer;background:rgba(20,10,35,0.5);border:1px solid rgba(255,255,255,0.18);color:#fff;padding:7px 10px;border-radius:10px;font-size:15px;display:flex;align-items:center;gap:5px;transition:.15s;font-weight:700}
  .wbtn.active{background:linear-gradient(135deg,#ffe6a3,#ffb23d);color:#2a1400;border-color:transparent;box-shadow:0 0 18px rgba(255,178,61,.6)}
  #ammoRow{display:flex;gap:3px;margin-top:2px}
  .pip{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,0.18);border:1px solid rgba(255,255,255,0.3)}
  .pip.full{background:var(--gold);box-shadow:0 0 6px var(--gold);border-color:var(--gold)}

  #combo{position:absolute;top:38%;left:50%;transform:translate(-50%,-50%) scale(0);color:#fff;font-size:38px;font-weight:800;font-family:'Orbitron';text-shadow:0 0 30px var(--gold);pointer-events:none;z-index:15;transition:transform 0.2s cubic-bezier(0.175,0.885,0.32,1.275);text-align:center;white-space:nowrap}
  #waveBanner{position:absolute;top:16%;left:50%;transform:translate(-50%,-20px) scale(0.8);opacity:0;color:var(--gold);font-family:'Orbitron';font-weight:900;font-size:22px;letter-spacing:6px;text-shadow:0 0 24px rgba(255,178,61,.8);pointer-events:none;z-index:15;transition:.35s}
  #waveBanner.show{opacity:1;transform:translate(-50%,0) scale(1)}
  #frenzyBadge{position:absolute;top:8%;left:50%;transform:translate(-50%,-10px);opacity:0;color:#fff6c9;font-family:'Orbitron';font-weight:900;font-size:15px;letter-spacing:3px;text-shadow:0 0 16px #ffd23f;pointer-events:none;z-index:15;transition:.3s;background:rgba(120,70,0,.35);padding:5px 16px;border-radius:20px;border:1px solid rgba(255,210,63,.5)}
  #frenzyBadge.show{opacity:1;transform:translate(-50%,0)}
  #floatScore{position:absolute;pointer-events:none;z-index:14;font-weight:800;font-size:19px;font-family:'Orbitron';color:#ffd23f;text-shadow:0 0 12px rgba(255,210,63,.8)}

  .overlay{position:absolute;inset:0;background:radial-gradient(ellipse at center, #2b1055 0%, #0c0620 72%);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:20;text-align:center;padding:20px}
  .overlay h1{font-family:'Orbitron';font-size:clamp(30px,7vw,50px);color:#fff;text-align:center;line-height:1.05;letter-spacing:-0.5px;text-shadow:0 0 40px rgba(255,178,61,0.55)}
  .overlay h1 span{color:var(--gold);display:block;font-size:clamp(13px,3vw,17px);margin-top:10px;letter-spacing:4px;font-weight:600;font-family:'Poppins'}
  .overlay p{color:rgba(255,255,255,0.72);margin:18px 0 22px;max-width:420px;text-align:center;font-size:14px;line-height:1.85}
  .bigBtn{padding:16px 50px;background:linear-gradient(135deg,#ffe6a3,#ffb23d);color:#2a1400;font-family:'Orbitron';font-size:16px;font-weight:800;border:none;border-radius:100px;cursor:pointer;box-shadow:0 0 40px rgba(255,178,61,0.45);transition:0.2s;letter-spacing:1px}
  .bigBtn:hover{transform:scale(1.05);box-shadow:0 0 60px rgba(255,178,61,0.8)}
  .hint{margin-top:16px;font-size:11.5px;opacity:0.55;max-width:380px;line-height:1.7}
  .legend{display:flex;gap:14px;margin-top:16px;flex-wrap:wrap;justify-content:center;max-width:420px}
  .legend div{font-size:11px;opacity:.75;display:flex;align-items:center;gap:5px}
  #gameOverStats{display:flex;gap:22px;margin:14px 0 24px;flex-wrap:wrap;justify-content:center}
  .goStat{text-align:center}
  .goStat .val{font-family:'Orbitron';font-size:28px;font-weight:900;color:var(--gold);text-shadow:0 0 20px rgba(255,178,61,.6)}
  .goStat .lab{font-size:10.5px;opacity:.6;letter-spacing:2px;margin-top:4px}
  #newBest{color:#ffe985;font-size:13px;letter-spacing:2px;margin-bottom:6px;text-shadow:0 0 14px rgba(255,210,63,.7);display:none;font-weight:700}
  #pauseOverlay h1{font-size:32px}

  #flash{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:19}
  #hazardFlash{position:absolute;inset:0;background:radial-gradient(circle at center, rgba(168,50,255,0.85), rgba(90,0,120,0.45) 40%, transparent 70%);opacity:0;pointer-events:none;z-index:18}
  #frenzyOverlay{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 60%, rgba(255,200,80,0.16), transparent 65%);opacity:0;pointer-events:none;z-index:5;transition:opacity .4s}
  #frenzyOverlay.on{opacity:1}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="flash"></div>
<div id="hazardFlash"></div>
<div id="frenzyOverlay"></div>

<div id="ui">
  <div id="leftStats">
    <div class="stat">SCORE <b id="score">0</b></div>
    <div class="stat">FEATHERS <b id="feathers">0</b></div>
  </div>
  <div id="rightStats">
    <div id="topRightRow">
      <div class="stat" style="margin-bottom:0">BEST <b id="best">0</b></div>
      <div id="pauseBtn">⏸</div>
    </div>
    <div id="lives"></div>
    <div id="weaponRow">
      <div class="wbtn active" id="swordBtn">🗡️ SWORD</div>
      <div class="wbtn" id="gunBtn">🔫 GUN</div>
    </div>
    <div id="ammoRow"></div>
  </div>
</div>

<div id="waveBanner">WAVE 1</div>
<div id="frenzyBadge">✨ PHOENIX FRENZY ✨</div>
<div id="combo">SATISFYING x2</div>

<div class="overlay" id="start">
  <h1>TALON STRIKE<span>JUNGLE ESTATE DEFENSE — PRO</span></h1>
  <p>Giant birds are diving out of the jungle canopy at your luxury cliffside estate. Swipe to swing your <b style="color:#fff">Talon Blade</b> and slice them clean in half, or switch to the <b style="color:#fff">Feather Gun</b> for precise ranged shots. Let too many reach the house and it's over.</p>
  <button class="bigBtn" id="play">⚔️ DEFEND THE ESTATE</button>
  <p class="hint">Swipe fast across a bird with the Sword. Tap to fire with the Gun (limited ammo, recharges over time). Missed birds cost a shield.</p>
  <div class="legend">
    <div>🦅 Falcon</div><div>🦜 Macaw</div><div>🦉 Owl</div><div>🦤 Toucan</div>
    <div style="color:#ffd23f">✨ Phoenix = Frenzy</div>
    <div style="color:#c9a2ff">⚡ Shadow Raven = avoid!</div>
  </div>
</div>

<div class="overlay" id="gameOver" style="display:none">
  <h1 id="goTitle">🏚️ ESTATE OVERRUN</h1>
  <div id="newBest">🏆 NEW BEST SCORE!</div>
  <div id="gameOverStats">
    <div class="goStat"><div class="val" id="goScore">0</div><div class="lab">SCORE</div></div>
    <div class="goStat"><div class="val" id="goFeathers">0</div><div class="lab">FEATHERS</div></div>
    <div class="goStat"><div class="val" id="goCombo">x0</div><div class="lab">BEST COMBO</div></div>
    <div class="goStat"><div class="val" id="goWave">1</div><div class="lab">WAVE REACHED</div></div>
  </div>
  <button class="bigBtn" id="retry">🔁 DEFEND AGAIN</button>
</div>

<div class="overlay" id="pauseOverlay" style="display:none">
  <h1>⏸ PAUSED</h1>
  <button class="bigBtn" id="resumeBtn">▶ RESUME</button>
</div>

<script>
(function(){
"use strict";
const canvas=document.getElementById('c');
const ctx=canvas.getContext('2d');
let W,H,dpr;
function resize(){dpr=window.devicePixelRatio||1;W=innerWidth;H=innerHeight;canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.width=W+'px';canvas.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}
resize();addEventListener('resize',resize);

// ---------- persistent best score ----------
let best=0;
try{ best=+localStorage.getItem('talonstrike_best')||0; }catch(e){ best=0; }
document.getElementById('best').textContent=best;

// ---------- state ----------
const STATE={START:'start',PLAYING:'playing',PAUSED:'paused',OVER:'over'};
let state=STATE.START;
const MAX_LIVES=25, MAX_AMMO=6, AMMO_REGEN_MS=820;

let score=0,feathers=0,lives=MAX_LIVES,combo=0,bestCombo=0,ammo=MAX_AMMO,ammoAccum=0;
let weapon='sword';
let objects=[],halves=[],particles=[],confetti=[],tracers=[],fireflies=[],pile=new Array(140).fill(0);
let timeScale=1,shake=0,slowTimerMs=0,lastSliceTime=0,muzzleFlash=0;
let spawnAccum=0,elapsed=0,difficultyLevel=0,waveShown=-1;
let frenzyMs=0;
let audioCtx;

function initAudio(){ if(!audioCtx){ try{ audioCtx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){} } }

// ================= SFX =================
function playSlice(material){
  if(!audioCtx) return;
  const t=audioCtx.currentTime;
  const osc=audioCtx.createOscillator(), g=audioCtx.createGain();
  osc.type='sawtooth'; osc.frequency.setValueAtTime(1600,t); osc.frequency.exponentialRampToValueAtTime(100,t+0.09);
  g.gain.setValueAtTime(0.75,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.15);
  osc.connect(g).connect(audioCtx.destination); osc.start(t); osc.stop(t+0.16);

  if(material==='feather'){
    const buf=audioCtx.createBuffer(1,audioCtx.sampleRate*0.3,audioCtx.sampleRate);
    const d=buf.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/d.length,2.2);
    const src=audioCtx.createBufferSource(); src.buffer=buf;
    const f=audioCtx.createBiquadFilter(); f.type='lowpass'; f.frequency.value=1400;
    const gg=audioCtx.createGain(); gg.gain.value=0.4;
    src.connect(f).connect(gg).connect(audioCtx.destination); src.start(t);
  } else if(material==='soft'){
    const buf=audioCtx.createBuffer(1,audioCtx.sampleRate*0.35,audioCtx.sampleRate);
    const d=buf.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/d.length,2);
    const src=audioCtx.createBufferSource(); src.buffer=buf;
    const f=audioCtx.createBiquadFilter(); f.type='lowpass'; f.frequency.value=900;
    const gg=audioCtx.createGain(); gg.gain.value=0.4;
    src.connect(f).connect(gg).connect(audioCtx.destination); src.start(t);
  } else if(material==='hard'){
    const buf=audioCtx.createBuffer(1,audioCtx.sampleRate*0.3,audioCtx.sampleRate);
    const d=buf.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/d.length,0.6);
    const src=audioCtx.createBufferSource(); src.buffer=buf;
    const f=audioCtx.createBiquadFilter(); f.type='bandpass'; f.frequency.value=1800; f.Q.value=1.2;
    const gg=audioCtx.createGain(); gg.gain.value=0.5;
    src.connect(f).connect(gg).connect(audioCtx.destination); src.start(t);
  } else if(material==='sparkle'){
    [1300,1650,2100,2600].forEach((f,idx)=>{
      const o=audioCtx.createOscillator(), g2=audioCtx.createGain();
      o.type='sine'; o.frequency.value=f;
      g2.gain.setValueAtTime(0.001,t+idx*0.05);
      g2.gain.linearRampToValueAtTime(0.18,t+idx*0.05+0.02);
      g2.gain.exponentialRampToValueAtTime(0.001,t+idx*0.05+0.3);
      o.connect(g2).connect(audioCtx.destination); o.start(t+idx*0.05); o.stop(t+idx*0.05+0.32);
    });
  }
}
function playGunshot(hit){
  if(!audioCtx) return;
  const t=audioCtx.currentTime;
  const buf=audioCtx.createBuffer(1,audioCtx.sampleRate*0.18,audioCtx.sampleRate);
  const d=buf.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/d.length,1.4);
  const src=audioCtx.createBufferSource(); src.buffer=buf;
  const f=audioCtx.createBiquadFilter(); f.type='bandpass'; f.frequency.value=1600; f.Q.value=0.7;
  const gg=audioCtx.createGain(); gg.gain.setValueAtTime(0.7,t); gg.gain.exponentialRampToValueAtTime(0.001,t+0.2);
  src.connect(f).connect(gg).connect(audioCtx.destination); src.start(t);
  const osc=audioCtx.createOscillator(), g2=audioCtx.createGain();
  osc.type='square'; osc.frequency.setValueAtTime(140,t); osc.frequency.exponentialRampToValueAtTime(40,t+0.1);
  g2.gain.setValueAtTime(0.4,t); g2.gain.exponentialRampToValueAtTime(0.001,t+0.12);
  osc.connect(g2).connect(audioCtx.destination); osc.start(t); osc.stop(t+0.13);
  if(hit) playSlice('feather');
}
function playEmptyClick(){
  if(!audioCtx) return;
  const t=audioCtx.currentTime;
  const osc=audioCtx.createOscillator(), g=audioCtx.createGain();
  osc.type='square'; osc.frequency.setValueAtTime(900,t);
  g.gain.setValueAtTime(0.15,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.05);
  osc.connect(g).connect(audioCtx.destination); osc.start(t); osc.stop(t+0.06);
}
function playHazardHit(){
  if(!audioCtx) return;
  const t=audioCtx.currentTime;
  const osc=audioCtx.createOscillator(), g2=audioCtx.createGain();
  osc.type='sawtooth'; osc.frequency.setValueAtTime(220,t); osc.frequency.exponentialRampToValueAtTime(25,t+0.5);
  g2.gain.setValueAtTime(0.55,t); g2.gain.exponentialRampToValueAtTime(0.001,t+0.55);
  osc.connect(g2).connect(audioCtx.destination); osc.start(t); osc.stop(t+0.56);
  for(let k=0;k<3;k++){
    const o2=audioCtx.createOscillator(), g3=audioCtx.createGain();
    o2.type='sawtooth'; o2.frequency.value=1400+Math.random()*1600;
    g3.gain.setValueAtTime(0.12,t+k*0.04); g3.gain.exponentialRampToValueAtTime(0.001,t+k*0.04+0.1);
    o2.connect(g3).connect(audioCtx.destination); o2.start(t+k*0.04); o2.stop(t+k*0.04+0.11);
  }
}
function playMiss(){
  if(!audioCtx) return;
  const t=audioCtx.currentTime;
  const osc=audioCtx.createOscillator(), g=audioCtx.createGain();
  osc.type='triangle'; osc.frequency.setValueAtTime(320,t); osc.frequency.exponentialRampToValueAtTime(110,t+0.25);
  g.gain.setValueAtTime(0.22,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.28);
  osc.connect(g).connect(audioCtx.destination); osc.start(t); osc.stop(t+0.3);
}
function playWaveChime(){
  if(!audioCtx) return;
  const t=audioCtx.currentTime;
  [660,880].forEach((f,i)=>{
    const o=audioCtx.createOscillator(), g=audioCtx.createGain();
    o.type='sine'; o.frequency.value=f;
    g.gain.setValueAtTime(0.001,t+i*0.09); g.gain.linearRampToValueAtTime(0.2,t+i*0.09+0.02); g.gain.exponentialRampToValueAtTime(0.001,t+i*0.09+0.3);
    o.connect(g).connect(audioCtx.destination); o.start(t+i*0.09); o.stop(t+i*0.09+0.32);
  });
}

// ---------- helper: half-plane clip for a slice ----------
function clipHalf(x,y,ang,side){
  ctx.beginPath();
  const a=ang+(side>0?0:Math.PI);
  const px=Math.cos(a)*2400, py=Math.sin(a)*2400;
  const qx=Math.cos(a+Math.PI/2)*2400, qy=Math.sin(a+Math.PI/2)*2400;
  ctx.moveTo(x,y);
  ctx.lineTo(x+px,y+py);
  ctx.lineTo(x+px+qx,y+py+qy);
  ctx.lineTo(x+qx,y+qy);
  ctx.closePath(); ctx.clip();
}

// ================= GENERIC BIRD RENDERER =================
function drawBirdGeneric(x,y,r,ang,side,cut,flap,colors,opts){
  opts=opts||{};
  ctx.save(); if(ang!==null) clipHalf(x,y,ang,side);
  ctx.fillStyle='rgba(0,0,0,0.32)'; ctx.beginPath(); ctx.ellipse(x+6,y+9,r*0.85,r*0.45,0,0,Math.PI*2); ctx.fill();

  if(opts.glow){ ctx.shadowColor=opts.glow; ctx.shadowBlur=26; }

  const spread=opts.wingSpread||1;
  [-1,1].forEach(function(m){
    ctx.save(); ctx.translate(x+m*r*0.12,y-r*0.02);
    ctx.rotate(m*(0.55+flap*0.85)*spread);
    const g=ctx.createLinearGradient(0,0,m*r*1.5,0);
    g.addColorStop(0,colors.wing1); g.addColorStop(1,colors.wing2);
    ctx.fillStyle=g;
    ctx.beginPath();
    ctx.moveTo(0,-r*0.1);
    ctx.quadraticCurveTo(m*r*0.95,-r*0.95,m*r*1.55,-r*0.12);
    ctx.quadraticCurveTo(m*r*0.9,r*0.08,m*r*0.28,r*0.38);
    ctx.closePath(); ctx.fill();
    ctx.strokeStyle='rgba(0,0,0,0.18)'; ctx.lineWidth=1.4;
    for(let i=1;i<=3;i++){
      ctx.beginPath(); ctx.moveTo(m*r*0.2*i,-r*0.08*i); ctx.lineTo(m*r*1.35,-r*0.08+i*r*0.07); ctx.stroke();
    }
    ctx.restore();
  });

  ctx.shadowBlur=0;

  ctx.fillStyle=colors.tail;
  ctx.beginPath();
  ctx.moveTo(x-r*0.22,y+r*0.32); ctx.lineTo(x,y+r*0.98); ctx.lineTo(x+r*0.22,y+r*0.32);
  ctx.closePath(); ctx.fill();

  if(opts.glow){ ctx.shadowColor=opts.glow; ctx.shadowBlur=20; }
  const bg=ctx.createRadialGradient(x-r*0.22,y-r*0.28,r*0.1,x,y,r*0.75);
  bg.addColorStop(0,colors.body1); bg.addColorStop(1,colors.body2);
  ctx.fillStyle=bg;
  ctx.beginPath(); ctx.ellipse(x,y+r*0.05,r*0.48,r*0.66,0,0,Math.PI*2); ctx.fill();
  ctx.shadowBlur=0;

  if(colors.belly){
    ctx.fillStyle=colors.belly;
    ctx.beginPath(); ctx.ellipse(x,y+r*0.26,r*0.3,r*0.38,0,0,Math.PI*2); ctx.fill();
  }

  ctx.fillStyle=colors.head||colors.body1;
  ctx.beginPath(); ctx.arc(x,y-r*0.56,r*0.3,0,Math.PI*2); ctx.fill();

  if(opts.crest){
    ctx.fillStyle=colors.crest||colors.head;
    ctx.beginPath(); ctx.moveTo(x-r*0.1,y-r*0.8); ctx.lineTo(x-r*0.02,y-r*1.16); ctx.lineTo(x+r*0.07,y-r*0.79); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(x+r*0.02,y-r*0.82); ctx.lineTo(x+r*0.14,y-r*1.1); ctx.lineTo(x+r*0.18,y-r*0.78); ctx.closePath(); ctx.fill();
  }

  ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(x+r*0.09,y-r*0.58,r*0.085,0,Math.PI*2); ctx.fill();
  ctx.fillStyle=opts.eyeColor||'#1a1a1a'; ctx.beginPath(); ctx.arc(x+r*0.11,y-r*0.58,r*0.042,0,Math.PI*2); ctx.fill();

  ctx.fillStyle=colors.beak||'#ffb400';
  if(opts.bigBeak){
    ctx.beginPath();
    ctx.moveTo(x+r*0.26,y-r*0.62); ctx.quadraticCurveTo(x+r*0.98,y-r*0.58,x+r*0.9,y-r*0.38);
    ctx.quadraticCurveTo(x+r*0.5,y-r*0.32,x+r*0.26,y-r*0.46); ctx.closePath(); ctx.fill();
    ctx.strokeStyle='rgba(0,0,0,0.25)'; ctx.lineWidth=1.2;
    ctx.beginPath(); ctx.moveTo(x+r*0.32,y-r*0.55); ctx.lineTo(x+r*0.82,y-r*0.5); ctx.stroke();
  } else {
    ctx.beginPath();
    ctx.moveTo(x+r*0.26,y-r*0.62); ctx.lineTo(x+r*0.56,y-r*0.53); ctx.lineTo(x+r*0.26,y-r*0.46);
    ctx.closePath(); ctx.fill();
  }

  if(opts.markings) opts.markings(ctx,x,y,r);

  if(cut){
    ctx.fillStyle=colors.fluff||'#fff8ec';
    ctx.beginPath(); ctx.ellipse(x,y,r*0.42,r*0.52,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle=colors.fluff2||'#ffe9c7';
    for(let i=0;i<9;i++){
      const a=Math.random()*Math.PI*2, rr=Math.random()*r*0.32;
      ctx.beginPath(); ctx.ellipse(x+Math.cos(a)*rr,y+Math.sin(a)*rr,r*0.08,r*0.13,a,0,Math.PI*2); ctx.fill();
    }
  }
  ctx.restore();
}

