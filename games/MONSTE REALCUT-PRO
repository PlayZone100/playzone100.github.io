// ================= HIT DETECTION HELPERS =================
const pointers=new Map();
function pointToSegmentDist(px,py,x1,y1,x2,y2){
  const A=px-x1,B=py-y1,C=x2-x1,D=y2-y1; const dot=A*C+B*D; const len=C*C+D*D||1;
  let t=Math.max(0,Math.min(1,dot/len)); const xx=x1+t*C,yy=y1+t*D; return Math.hypot(px-xx,py-yy);
}

function triggerFrenzy(){
  frenzyMs=3400;
  document.getElementById('frenzyOverlay').classList.add('on');
  document.getElementById('frenzyBadge').classList.add('show');
  playWaveChime();
}

function triggerHit(o,dirAng,atX,atY,method){
  o.sliced=true;
  const idx=objects.indexOf(o); if(idx>=0) objects.splice(idx,1);

  if(o.isHazard){
    playHazardHit();
    shake=Math.min(shake+26,30); timeScale=0.22; slowTimerMs=280;
    const hz=document.getElementById('hazardFlash');
    hz.style.transition='none'; hz.style.opacity='1';
    for(let k=0;k<55;k++){
      const a=Math.random()*Math.PI*2, sp=Math.random()*13+2;
      particles.push({x:o.x,y:o.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-2,life:1,decay:0.011,color:Math.random()>0.5?'#a86bff':'#2a1042',size:Math.random()*6+2,shard:Math.random()>0.5});
    }
    setTimeout(function(){ hz.style.transition='opacity .6s'; hz.style.opacity='0'; },70);
    spawnFloatScore(atX!=null?atX:o.x, atY!=null?atY:o.y, 'SHIELD LOST', false, true);
    loseLife();
    return;
  }

  const def=o.def;
  const ang=dirAng+Math.PI/2;
  const sideA={x:o.x+Math.cos(ang)*8,y:o.y+Math.sin(ang)*8,vx:o.vx+Math.cos(ang)*4,vy:o.vy+Math.sin(ang)*2,r:o.r,rot:o.rot,rotV:o.rotV+0.15,cut:ang,side:-1,life:1,def,gravity:o.gravity};
  const sideB={x:o.x-Math.cos(ang)*8,y:o.y-Math.sin(ang)*8,vx:o.vx-Math.cos(ang)*4,vy:o.vy-Math.sin(ang)*2,r:o.r,rot:o.rot,rotV:o.rotV-0.15,cut:ang,side:1,life:1,def,gravity:o.gravity};
  halves.push(sideA,sideB);

  const isSoft=def.material==='soft';
  const isHard=def.material==='hard';
  const count=isHard?90:(isSoft?80:70);
  const palette=def.particle;
  for(let k=0;k<count;k++){
    particles.push({
      x:o.x,y:o.y,
      vx:(Math.random()-0.5)*(isHard?15:11)+Math.cos(ang)*(isSoft?0.6:3),
      vy:(Math.random()-0.5)*(isHard?15:11)+Math.sin(ang)*2-2,
      life:1, decay:isSoft?0.0038:0.012,
      color:palette[Math.floor(Math.random()*palette.length)],
      size:isSoft?Math.random()*5.5+2.5:(isHard?Math.random()*3.5+1.5:Math.random()*4+1.5),
      shard:isHard
    });
  }
  if(def.key==='phoenix'){
    for(let k=0;k<36;k++){
      confetti.push({x:o.x,y:o.y,vx:(Math.random()-0.5)*9,vy:-Math.random()*8-2,rot:Math.random()*Math.PI*2,rotV:(Math.random()-0.5)*0.3,life:1,color:palette[Math.floor(Math.random()*palette.length)],w:6,h:10});
    }
  }

  playSlice(def.material==='hard'?'hard':def.material==='soft'?'soft':def.material==='sparkle'?'sparkle':'feather');
  if(method==='gun') playGunshot(true);

  const isPhoenix=def.key==='phoenix';
  const now=performance.now();
  const withinCombo=now-lastSliceTime<440;
  if(withinCombo){ combo++; } else { combo=0; }
  lastSliceTime=now;
  bestCombo=Math.max(bestCombo,combo+1);
  let mult=Math.min(1+combo*0.5,5);
  if(frenzyMs>0) mult*=2;
  const gained=Math.round(def.score*mult);
  score+=gained; feathers+=def.feathers;

  document.getElementById('score').textContent=score;
  document.getElementById('feathers').textContent=feathers;

  if(combo>0 || isPhoenix){
    const el=document.getElementById('combo');
    el.textContent=isPhoenix? '✨ PHOENIX x'+(combo+1)+'!' : 'TALON DOWN x'+(combo+1);
    el.style.transform='translate(-50%,-50%) scale(1.2)';
    clearTimeout(el._t);
    el._t=setTimeout(function(){ el.style.transform='translate(-50%,-50%) scale(0)'; },320);
  }

  spawnFloatScore(atX!=null?atX:o.x, atY!=null?atY:o.y, '+'+gained, isPhoenix, false);

  if(isPhoenix) triggerFrenzy();

  timeScale=0.18; slowTimerMs=130; shake=Math.min(shake+(method==='gun'?9:7),16);
  flashPulse();
}

