const stars=[];
for(let i=0;i<70;i++){ stars.push({x:Math.random(),y:Math.random()*0.45,phase:Math.random()*10,r:0.6+Math.random()*1.3}); }

function drawBackground(now){
  // sky gradient — dusk over the jungle
  const sky=ctx.createLinearGradient(0,0,0,H);
  sky.addColorStop(0,'#160a33');
  sky.addColorStop(0.45,'#4a2166');
  sky.addColorStop(0.72,'#a8497a');
  sky.addColorStop(1,'#ff9257');
  ctx.fillStyle=sky; ctx.fillRect(0,0,W,H);

  // stars
  stars.forEach(function(s){
    const a=0.35+0.4*Math.sin(now*0.0015+s.phase);
    ctx.globalAlpha=Math.max(0,a);
    ctx.fillStyle='#fff';
    ctx.beginPath(); ctx.arc(s.x*W,s.y*H,s.r,0,Math.PI*2); ctx.fill();
  });
  ctx.globalAlpha=1;

  // moon
  ctx.save();
  ctx.shadowColor='rgba(255,244,214,0.8)'; ctx.shadowBlur=40;
  ctx.fillStyle='#fff4d6';
  ctx.beginPath(); ctx.arc(W*0.82,H*0.16,Math.min(W,H)*0.045,0,Math.PI*2); ctx.fill();
  ctx.restore();

  // distant hill silhouette
  ctx.fillStyle='rgba(20,10,40,0.55)';
  ctx.beginPath(); ctx.moveTo(0,H*0.62);
  for(let x=0;x<=W;x+=40){ ctx.lineTo(x,H*0.62+Math.sin(x*0.01+1)*18); }
  ctx.lineTo(W,H); ctx.lineTo(0,H); ctx.closePath(); ctx.fill();

  // jungle canopy silhouette (mid)
  ctx.fillStyle='rgba(10,30,22,0.85)';
  ctx.beginPath(); ctx.moveTo(0,H*0.74);
  for(let x=0;x<=W;x+=26){ ctx.lineTo(x,H*0.74+Math.sin(x*0.045+3)*14+Math.sin(x*0.012)*10); }
  ctx.lineTo(W,H); ctx.lineTo(0,H); ctx.closePath(); ctx.fill();

  // infinity pool strip
  const poolTop=H*0.86;
  const pg=ctx.createLinearGradient(0,poolTop,0,H);
  pg.addColorStop(0,'#1fb3ad'); pg.addColorStop(1,'#0a5f5c');
  ctx.fillStyle=pg; ctx.fillRect(0,poolTop,W,H-poolTop);
  ctx.strokeStyle='rgba(255,255,255,0.22)'; ctx.lineWidth=1.5;
  for(let i=0;i<5;i++){
    const yy=poolTop+8+i*((H-poolTop-8)/5)+Math.sin(now*0.001+i)*2;
    ctx.beginPath();
    for(let x=0;x<=W;x+=20){ const yy2=yy+Math.sin(x*0.03+now*0.0015+i)*2; if(x===0)ctx.moveTo(x,yy2); else ctx.lineTo(x,yy2); }
    ctx.stroke();
  }

  // foreground palm silhouettes (corners, luxury framing)
  ctx.fillStyle='rgba(4,14,10,0.9)';
  drawPalm(W*0.06,H*0.9,80,-0.25);
  drawPalm(W*0.97,H*0.92,90,0.2);

  // balcony railing + tiki torches + string lights
  const railY=H*0.955;
  ctx.fillStyle='rgba(15,8,10,0.9)';
  ctx.fillRect(0,railY,W,H-railY);
  ctx.strokeStyle='rgba(255,220,180,0.35)'; ctx.lineWidth=2;
  ctx.beginPath(); ctx.moveTo(0,railY); ctx.lineTo(W,railY); ctx.stroke();
  for(let x=20;x<W;x+=70){
    const flick=0.7+0.3*Math.sin(now*0.01+x);
    ctx.fillStyle='rgba(255,214,140,'+(0.55*flick)+')';
    ctx.shadowColor='#ffd68c'; ctx.shadowBlur=8;
    ctx.beginPath(); ctx.arc(x,railY+4,3,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=0;
  }
  for(let x=55;x<W;x+=160){
    ctx.fillStyle='rgba(60,35,15,0.9)';
    ctx.fillRect(x-2,railY-22,4,22);
    const fl=0.6+0.4*Math.sin(now*0.02+x*2);
    ctx.fillStyle='rgba(255,150,40,'+fl+')';
    ctx.shadowColor='#ff8a1a'; ctx.shadowBlur=14;
    ctx.beginPath(); ctx.ellipse(x,railY-27,4,7+fl*2,0,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=0;
  }

  // fireflies
  fireflies.forEach(function(f){
    const fx=(f.x*0.001*W+now*0.02*f.speed)%W;
    const fy=H*0.3+((Math.sin(now*0.0006+f.phase))*H*0.25)+H*0.2;
    const a=0.4+0.5*Math.sin(now*0.004+f.phase);
    ctx.globalAlpha=Math.max(0,a);
    ctx.fillStyle='#e8ff9e'; ctx.shadowColor='#e8ff9e'; ctx.shadowBlur=6;
    ctx.beginPath(); ctx.arc(fx,fy,f.r,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=0;
  });
  ctx.globalAlpha=1;
}
function drawPalm(x,y,size,lean){
  ctx.save(); ctx.translate(x,y); ctx.rotate(lean*0.15);
  ctx.fillRect(-size*0.045,-size*1.1,size*0.09,size*1.1);
  for(let i=0;i<6;i++){
    const a=(i/6)*Math.PI*2*0.65 - Math.PI*0.62 + lean;
    ctx.save(); ctx.rotate(a);
    ctx.beginPath();
    ctx.moveTo(0,-size*1.1);
    ctx.quadraticCurveTo(size*0.5,-size*1.4,size*0.9,-size*1.05);
    ctx.quadraticCurveTo(size*0.45,-size*1.15,0,-size*1.1);
    ctx.fill();
    ctx.restore();
  }
  ctx.restore();
}

// ================= GAME LOOP =================
let lastFrame=performance.now();
function loop(now){
  requestAnimationFrame(loop);
  let realDt=now-lastFrame; lastFrame=now;
  realDt=Math.min(realDt,50);

  if(slowTimerMs>0){ slowTimerMs-=realDt; if(slowTimerMs<=0) timeScale=1; }
  if(shake>0) shake*=0.85;
  if(muzzleFlash>0) muzzleFlash=Math.max(0,muzzleFlash-realDt*0.012);

  if(state===STATE.PLAYING && frenzyMs>0){
    frenzyMs-=realDt;
    if(frenzyMs<=0){
      document.getElementById('frenzyOverlay').classList.remove('on');
      document.getElementById('frenzyBadge').classList.remove('show');
    }
  }

  if(state===STATE.PLAYING && ammo<MAX_AMMO){
    ammoAccum+=realDt;
    if(ammoAccum>AMMO_REGEN_MS){ ammoAccum=0; ammo=Math.min(MAX_AMMO,ammo+1); renderAmmo(); }
  }

  const dt=realDt*timeScale/16.6667;

  ctx.save();
  if(shake>1) ctx.translate((Math.random()-0.5)*shake,(Math.random()-0.5)*shake);

  drawBackground(now);

  // feather / debris pile along the balcony
  ctx.fillStyle='rgba(255,235,210,0.16)'; ctx.beginPath(); ctx.moveTo(0,H*0.955);
  for(let i=0;i<pile.length;i++){ const x=(i/pile.length)*W, h=pile[i]; ctx.lineTo(x,H*0.955-h); }
  ctx.lineTo(W,H*0.955); ctx.closePath(); ctx.fill();

  if(state===STATE.PLAYING){
    elapsed+=realDt;
    difficultyLevel=Math.min(20,Math.floor(elapsed/8000));
    if(difficultyLevel!==waveShown){
      waveShown=difficultyLevel;
      const wb=document.getElementById('waveBanner');
      wb.textContent='WAVE '+(difficultyLevel+1);
      wb.classList.add('show');
      playWaveChime();
      clearTimeout(wb._t);
      wb._t=setTimeout(function(){ wb.classList.remove('show'); },1400);
    }
    spawnAccum+=realDt;
    const interval=Math.max(400,880-difficultyLevel*27);
    if(spawnAccum>interval){
      spawnAccum=0;
      const burst=1+(Math.random()<Math.min(0.5,0.08+difficultyLevel*0.03)?1:0);
      for(let k=0;k<burst;k++) setTimeout(spawnBird,k*90);
      if(Math.random()<Math.min(0.3,0.05+difficultyLevel*0.012)) setTimeout(spawnHazard,150);
    }

    for(let i=objects.length-1;i>=0;i--){
      const o=objects[i];
      o.x+=o.vx*dt; o.y+=o.vy*dt; o.vy+=o.gravity*dt; o.rot+=o.rotV*dt;
      if(o.y>H+120){
        objects.splice(i,1);
        if(!o.isHazard && o.def && o.def.life){
          loseLife();
          playMiss();
        }
      }
    }
  }

  for(let i=0;i<objects.length;i++){
    const o=objects[i];
    const flap=Math.sin(now*0.012+o.phase)*0.55;
    ctx.save(); ctx.translate(o.x,o.y); ctx.rotate(o.rot);
    if(o.isHazard) drawStormRaven(0,0,o.r*0.62,null,0,false,flap);
    else o.def.draw(0,0,o.r*0.62,null,0,false,flap);
    ctx.restore();
  }

  if(state===STATE.PLAYING){
    for(let i=halves.length-1;i>=0;i--){
      const h=halves[i];
      h.x+=h.vx*dt; h.y+=h.vy*dt; h.vy+=h.gravity*dt; h.rot+=h.rotV*dt; h.life-=0.008*dt;
      if(h.life<=0||h.y>H+150) halves.splice(i,1);
    }
  }
  for(let i=0;i<halves.length;i++){
    const h=halves[i];
    ctx.save(); ctx.translate(h.x,h.y); ctx.rotate(h.rot);
    h.def.draw(0,0,h.r*0.62,h.cut,h.side,true,0);
    ctx.restore();
  }

  if(state===STATE.PLAYING){
    for(let i=particles.length-1;i>=0;i--){
      const p=particles[i];
      p.x+=p.vx*dt; p.y+=p.vy*dt; p.vy+=(p.shard?0.28:0.2)*dt; p.vx*=Math.pow(0.99,dt); p.life-=p.decay*dt;
      if(p.life<=0){
        const idx=Math.floor((p.x/W)*pile.length);
        if(p.y>=H*0.955-(pile[idx]||0)-5 && idx>=0 && idx<pile.length) pile[idx]=Math.min(110,pile[idx]+p.size*0.28);
        particles.splice(i,1); continue;
      }
    }
    for(let i=confetti.length-1;i>=0;i--){
      const c=confetti[i];
      c.x+=c.vx*dt; c.y+=c.vy*dt; c.vy+=0.22*dt; c.rot+=c.rotV*dt; c.life-=0.006*dt;
      if(c.life<=0||c.y>H+50) confetti.splice(i,1);
    }
    for(let i=tracers.length-1;i>=0;i--){
      const tr=tracers[i]; tr.life-=0.09*dt;
      if(tr.life<=0) tracers.splice(i,1);
    }
  }
  for(let i=0;i<particles.length;i++){
    const p=particles[i];
    ctx.globalAlpha=Math.max(0,p.life);
    ctx.fillStyle=p.color;
    if(p.shard){
      ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.x*0.1);
      ctx.beginPath(); ctx.moveTo(0,-p.size); ctx.lineTo(p.size*0.7,p.size*0.4); ctx.lineTo(-p.size*0.7,p.size*0.5); ctx.closePath(); ctx.fill();
      ctx.restore();
    } else {
      ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,Math.PI*2); ctx.fill();
    }
  }
  for(let i=0;i<confetti.length;i++){
    const c=confetti[i];
    ctx.save(); ctx.globalAlpha=Math.max(0,c.life); ctx.translate(c.x,c.y); ctx.rotate(c.rot);
    ctx.fillStyle=c.color; ctx.fillRect(-c.w/2,-c.h/2,c.w,c.h);
    ctx.restore();
  }
  ctx.globalAlpha=1;

  // gun tracers + muzzle flash + player turret marker
  const origin=PLAYER_ORIGIN();
  for(let i=0;i<tracers.length;i++){
    const tr=tracers[i];
    ctx.globalAlpha=Math.max(0,tr.life);
    ctx.strokeStyle='#ffe6a3'; ctx.lineWidth=2.5; ctx.shadowColor='#ffb23d'; ctx.shadowBlur=12;
    ctx.beginPath(); ctx.moveTo(tr.x1,tr.y1); ctx.lineTo(tr.x2,tr.y2); ctx.stroke();
    ctx.shadowBlur=0;
  }
  ctx.globalAlpha=1;
  if(muzzleFlash>0){
    ctx.globalAlpha=muzzleFlash;
    const g=ctx.createRadialGradient(origin.x,origin.y,0,origin.x,origin.y,30);
    g.addColorStop(0,'#fff7d6'); g.addColorStop(1,'rgba(255,178,61,0)');
    ctx.fillStyle=g; ctx.beginPath(); ctx.arc(origin.x,origin.y,30,0,Math.PI*2); ctx.fill();
    ctx.globalAlpha=1;
  }
  if(weapon==='gun' && state===STATE.PLAYING){
    ctx.strokeStyle='rgba(255,210,122,0.55)'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.arc(origin.x,origin.y,10,0,Math.PI*2); ctx.stroke();
  }

  // sword trails (all active pointers)
  pointers.forEach(function(p){
    const trail=p.trail;
    if(trail.length>1){
      ctx.strokeStyle='#ffffff'; ctx.lineWidth=4; ctx.shadowBlur=20; ctx.shadowColor='#fff'; ctx.lineCap='round'; ctx.lineJoin='round';
      ctx.beginPath(); ctx.moveTo(trail[0].x,trail[0].y);
      for(let i=1;i<trail.length;i++) ctx.lineTo(trail[i].x,trail[i].y);
      ctx.stroke(); ctx.shadowBlur=0;
      ctx.strokeStyle='rgba(255,210,122,0.85)'; ctx.lineWidth=1.5;
      ctx.beginPath(); ctx.moveTo(trail[0].x,trail[0].y);
      for(let i=1;i<trail.length;i++) ctx.lineTo(trail[i].x,trail[i].y);
      ctx.stroke();
    }
  });

  ctx.restore();
}
requestAnimationFrame(loop);

renderLives(); renderAmmo();
})();
</script>
