// ================= WEAPON: SWORD =================
function handleDown(id,x,y){
  initAudio();
  if(state!==STATE.PLAYING) return;
  if(weapon==='gun'){ fireGun(x,y); return; }
  pointers.set(id,{trail:[{x,y}]});
}
function handleMove(id,x,y){
  if(state!==STATE.PLAYING || weapon!=='sword') return;
  const p=pointers.get(id);
  if(!p) return;
  const last=p.trail[p.trail.length-1];
  const dx=x-last.x, dy=y-last.y, spd=Math.hypot(dx,dy);
  p.trail.push({x,y,t:performance.now()});
  if(p.trail.length>14) p.trail.shift();
  if(p.trail.length<2) return;
  const p1=p.trail[p.trail.length-2], p2=p.trail[p.trail.length-1];
  if(spd<6) return;
  const dirAng=Math.atan2(dy,dx);
  for(let i=objects.length-1;i>=0;i--){
    const o=objects[i];
    if(o.sliced) continue;
    const dist=pointToSegmentDist(o.x,o.y,p1.x,p1.y,p2.x,p2.y);
    if(dist<o.r+22){ triggerHit(o,dirAng,x,y,'sword'); }
  }
}
function handleUp(id){ pointers.delete(id); }

canvas.addEventListener('pointerdown', function(e){ canvas.setPointerCapture(e.pointerId); handleDown(e.pointerId,e.clientX,e.clientY); });
canvas.addEventListener('pointermove', function(e){ handleMove(e.pointerId,e.clientX,e.clientY); });
canvas.addEventListener('pointerup', function(e){ handleUp(e.pointerId); });
canvas.addEventListener('pointercancel', function(e){ handleUp(e.pointerId); });

// ================= WEAPON: GUN =================
function fireGun(x,y){
  if(state!==STATE.PLAYING) return;
  if(ammo<=0){ playEmptyClick(); return; }
  ammo--; ammoAccum=0; renderAmmo();
  const origin=PLAYER_ORIGIN();
  tracers.push({x1:origin.x,y1:origin.y,x2:x,y2:y,life:1});
  muzzleFlash=1;
  shake=Math.min(shake+6,14);
  let hitAny=false;
  for(let i=objects.length-1;i>=0;i--){
    const o=objects[i];
    if(o.sliced) continue;
    const d=Math.hypot(o.x-x,o.y-y);
    if(d<o.r+34){
      hitAny=true;
      const dirAng=Math.atan2(o.y-origin.y,o.x-origin.x);
      triggerHit(o,dirAng,x,y,'gun');
    }
  }
  if(!hitAny){
    playGunshot(false);
    for(let k=0;k<14;k++){
      const a=Math.random()*Math.PI*2, sp=Math.random()*5+1;
      particles.push({x:x,y:y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:1,decay:0.03,color:'#ffe6a3',size:Math.random()*2.5+1,shard:false});
    }
  }
}

