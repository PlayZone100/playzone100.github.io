# Environment template for the text-to-video proxy
# Fill these values with your real upstream API endpoint and key.

PORT=3000
TEXT_TO_VIDEO_API_URL=https://your-video-api.example.com/generate
TEXT_TO_VIDEO_API_KEY=your_api_key_here
TEXT_TO_VIDEO_TIMEOUT_MS=120000
DEFAULT_MODEL_NAME=ltx-video

# Optional: any upstream-specific settings you want to pass through
# TEXT_TO_VIDEO_EXTRA_BODY={"width":768,"height":432}
