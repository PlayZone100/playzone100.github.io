<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>What's In My Fridge? 60+ Genius Recipes to Cook Tonight</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-cream:#FFF6E9;
    --bg-white:#FFFFFF;
    --ink:#2B2118;
    --ink-soft:#5A4E42;
    --tomato:#E1503B;
    --tomato-dark:#B83A2A;
    --avocado:#4F7A3E;
    --avocado-dark:#375B29;
    --mustard:#F2A93C;
    --mustard-dark:#C9821F;
    --eggplant:#4B2A46;
    --eggplant-light:#6E3B5C;
    --cream-card:#FFFDF8;
    --line:rgba(43,33,24,0.12);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Public Sans', system-ui, sans-serif;
    color:var(--ink);
    background:var(--bg-cream);
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;}
  h1,h2,h3{
    font-family:'Bricolage Grotesque', system-ui, sans-serif;
    line-height:1.1;
    margin:0 0 0.5em;
    font-weight:700;
  }
  .container{max-width:760px;margin:0 auto;padding:0 24px;}
  a{color:var(--tomato-dark);}
  .wrap-narrow{max-width:680px;}

  /* HERO */
  .hero{
    background:linear-gradient(160deg, var(--eggplant) 0%, var(--eggplant-light) 55%, var(--tomato-dark) 130%);
    color:#FFF6E9;
    padding:76px 24px 96px;
    position:relative;
    overflow:hidden;
  }
  .hero .eyebrow{
    font-size:1.05rem;
    color:#F6D9A8;
    margin-bottom:14px;
  }
  .hero h1{
    font-size:clamp(2.1rem, 5vw, 3.2rem);
    max-width:14ch;
    color:#FFFDF8;
  }
  .hero p{
    max-width:48ch;
    font-size:1.15rem;
    color:#F3DFC9;
    margin-top:14px;
  }
  .hero-emoji-row{font-size:1.8rem; margin-top:28px; letter-spacing:6px;}

  .wave{display:block;width:100%;height:60px;margin-bottom:-6px;}

  /* BANDS */
  .band{padding:64px 0;}
  .band-cream{background:var(--bg-cream);}
  .band-white{background:var(--bg-white);}
  .band-yellow{background:#FCEBC9;}
  .band-green{background:#E3EDD8;}
  .band-red{background:#F9DCD3;}
  .band-dark{background:linear-gradient(135deg, var(--eggplant) 0%, var(--tomato-dark) 130%); color:#FFF6E9;}

  h2.section-title{
    font-size:clamp(1.5rem, 3.4vw, 2.05rem);
    margin-bottom:20px;
  }
  .section-kicker{
    display:inline-block;
    font-size:0.95rem;
    font-weight:600;
    color:var(--tomato-dark);
    background:#FFFFFF;
    padding:4px 14px;
    border-radius:100px;
    margin-bottom:14px;
    border:1px solid var(--line);
  }

  /* INTRO BENEFIT CHIPS */
  .chip-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(190px,1fr));
    gap:14px;
    margin-top:30px;
  }
  .chip{
    background:var(--cream-card);
    border:1px solid var(--line);
    border-radius:16px;
    padding:18px 18px;
  }
  .chip .chip-emoji{font-size:1.6rem; display:block; margin-bottom:8px;}
  .chip strong{display:block; margin-bottom:4px; font-size:1.02rem;}
  .chip span.sub{color:var(--ink-soft); font-size:0.92rem;}

  /* TIP BOX */
  .tip-box{
    background:#FFFDF8;
    border:2px dashed var(--mustard-dark);
    border-radius:14px;
    padding:18px 22px;
    margin:28px 0;
  }
  .tip-box .label{font-weight:700; color:var(--mustard-dark);}

  /* RECIPE CARD LIST */
  ul.recipe-list{list-style:none; padding:0; margin:22px 0;}
  ul.recipe-list li{
    padding:12px 0 12px 34px;
    position:relative;
    border-bottom:1px solid var(--line);
  }
  ul.recipe-list li:last-child{border-bottom:none;}
  ul.recipe-list li::before{
    content:"🍽";
    position:absolute;
    left:0;
    top:11px;
    font-size:1rem;
  }
  ul.recipe-list li strong{color:var(--tomato-dark);}

  /* FORMULA BOX */
  .formula-box{
    background:var(--avocado);
    color:#F2F8EA;
    border-radius:18px;
    padding:24px 26px;
    margin:24px 0;
    font-size:1.08rem;
  }
  .formula-box strong{color:#FFF3D0;}

  /* PANTRY TABLE */
  .table-wrap{overflow-x:auto; margin-top:24px; border-radius:14px; border:1px solid var(--line);}
  table{border-collapse:collapse; width:100%; background:#FFFDF8; min-width:480px;}
  th,td{text-align:left; padding:13px 16px; font-size:0.98rem;}
  thead th{background:var(--mustard); color:#3A2508; font-family:'Bricolage Grotesque'; font-weight:700;}
  tbody tr:nth-child(odd){background:#FFF8EA;}
  tbody tr:not(:last-child) td{border-bottom:1px solid var(--line);}

  /* FULL RECIPE GRID */
  .recipe-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(230px,1fr));
    gap:18px;
    margin-top:28px;
  }
  .recipe-grid .card{
    background:var(--cream-card);
    border-radius:18px;
    padding:22px;
    border:1px solid var(--line);
    box-shadow:0 2px 0 var(--line);
  }
  .recipe-grid .card h3{font-size:1.08rem; color:var(--tomato-dark); margin-bottom:8px;}
  .recipe-grid .card p{margin:0; font-size:0.96rem; color:var(--ink-soft);}

  /* CTA */
  .cta-box{
    text-align:center;
    padding:48px 30px;
    border-radius:22px;
  }
  .cta-box h2{color:#FFFDF8; font-size:clamp(1.5rem,3.5vw,2.1rem);}
  .cta-box p{color:#F3DFC9; max-width:52ch; margin:14px auto 26px;}
  .btn{
    display:inline-block;
    background:var(--mustard);
    color:#3A2508;
    font-weight:700;
    padding:14px 30px;
    border-radius:100px;
    text-decoration:none;
    font-size:1.05rem;
  }
  .btn:hover{background:#FFC369;}

  /* FAQ */
  details{
    background:var(--cream-card);
    border:1px solid var(--line);
    border-left:5px solid var(--avocado);
    border-radius:12px;
    padding:14px 18px;
    margin-bottom:12px;
  }
  summary{
    font-family:'Bricolage Grotesque';
    font-weight:700;
    cursor:pointer;
    font-size:1.02rem;
  }
  details p{margin:10px 0 2px; color:var(--ink-soft);}

  footer{
    text-align:center;
    padding:40px 24px 60px;
    color:var(--ink-soft);
    font-size:0.92rem;
  }

  @media (max-width:560px){
    .band{padding:48px 0;}
    .hero{padding:56px 20px 80px;}
  }
</style>
